{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/recommend.ts": {
      "maxDuration": 300
    },
    "api/plan.ts": {
      "maxDuration": 300
    },
    "api/health.ts": {
      "maxDuration": 60
    },
    "api/diag.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 300
    },
    "api/trips.ts": {
      "maxDuration": 30
    },
    "api/intent.ts": {
      "maxDuration": 60
    }
  }
}
