{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/diag",
      "destination": "/api/health?check=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/recommend.ts": {
      "maxDuration": 300
    },
    "api/plan.ts": {
      "maxDuration": 300
    },
    "api/health.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 300
    },
    "api/trips.ts": {
      "maxDuration": 30
    },
    "api/intent.ts": {
      "maxDuration": 60
    },
    "api/profile.ts": {
      "maxDuration": 30
    },
    "api/pnr.ts": {
      "maxDuration": 30
    },
    "api/paylink.ts": {
      "maxDuration": 30
    },
    "api/pay.ts": {
      "maxDuration": 30
    },
    "api/booking.ts": {
      "maxDuration": 30
    },
    "api/voice.ts": {
      "maxDuration": 300
    }
  }
}
