# Server-only. Never prefix with VITE_ (that would publish it in the browser bundle).
GEMINI_API_KEY=
# Optional: pin a model. If unset, the app tries current Flash models in order.
GEMINI_MODEL=
# Optional: total time the server waits for Gemini (ms, default 280000). Keep it below vercel.json maxDuration.
GEMINI_TIMEOUT_MS=
# Optional: max time for one model before trying the next (ms, default 90000).
GEMINI_ATTEMPT_MS=
